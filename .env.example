# =============================================================================
# Licitaciones Andalucía — variables de entorno
# Copia este fichero a .env y rellena los valores reales. NO subas .env a Git.
# =============================================================================

# --- Anthropic (IA) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Airtable (panel del equipo) ---
AIRTABLE_API_KEY=patxxxxxxxxxxxxxxxxxxxxxx
AIRTABLE_BASE_ID=appxxxxxxxxxxxxxx
AIRTABLE_TABLE_LICITACIONES=Licitaciones

# --- Resend (correo) ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=licitaciones@tudominio.com
EMAIL_FROM_NAME=Bot Licitaciones
EMAIL_TO=ventas@tudominio.com,direccion@tudominio.com

# --- PLACSP ---
PLACSP_BASE_URL=https://contrataciondelsectorpublico.gob.es/sindicacion/sindicacion_643
PLACSP_USER_AGENT=LicitacionesBot/1.0 (contacto@tudominio.com)

# --- Rutas (relativas a la raíz del proyecto) ---
DB_PATH=./data/licitaciones.db
ZIPS_DIR=./data/zips
PLIEGOS_DIR=./data/pliegos
LOG_DIR=./logs
LOG_LEVEL=INFO

# --- Filtros duros ---
IMPORTE_MIN=1000
IMPORTE_MAX=500000
PROVINCIAS_PERMITIDAS=Cádiz,Sevilla,Málaga,Granada,Jaén,Córdoba,Huelva

# --- IA ---
PROMPT_VERSION=v1
MAX_PDF_PAGES=80
COSTE_MAX_DIARIO_USD=5

# --- Programación ---
HORA_ENVIO_RESUMEN=07:00
TIMEZONE=Europe/Madrid
